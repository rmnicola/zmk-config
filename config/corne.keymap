#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    combos {
        compatible = "zmk,combos";

        df_enter {
            bindings = <&kp RET>;
            key-positions = <15 16>;
        };

        jk_esc {
            bindings = <&kp ESCAPE>;
            key-positions = <19 20>;
        };

        fj_caps {
            bindings = <&kp CAPSLOCK>;
            key-positions = <16 19>;
        };

        space {
            bindings = <&kp SPACE>;
            key-positions = <37 40>;
        };

        bk_word {
            bindings = <&kp LC(BACKSPACE)>;
            key-positions = <38 41>;
        };
    };

    behaviors {
        homerow: homerow {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <150>;
        };

        homerow_shift: homerow_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_SHIFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            require-prior-idle-ms = <120>;
        };

        accent: accent {
            compatible = "zmk,behavior-hold-tap";
            label = "ACCENT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "tap-preferred";
        };

        otilcar: otilcar {
            compatible = "zmk,behavior-hold-tap";
            label = "OTILCAR";
            bindings = <&m_ocaret>, <&m_otilde>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
        };

        atilcar: atilcar {
            compatible = "zmk,behavior-hold-tap";
            label = "ATILCAR";
            bindings = <&m_acaret>, <&m_atilde>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
        };

        atilcarcra: atilcarcra {
            compatible = "zmk,behavior-tap-dance";
            label = "ATILCARCRA";
            #binding-cells = <0>;
            bindings = <&atilcar 0 0>, <&m_crase>;

            tapping-term-ms = <180>;
        };
    };

    macros {
        m_quote: quotes {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SINGLE_QUOTE &kp SPACE>;
            label = "m_quote";
        };

        m_dquotes: m_dquotes {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOUBLE_QUOTES &kp SPACE>;
            label = "M_DQUOTES";
        };

        m_grave: m_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp SPACE>;
            label = "M_GRAVE";
        };

        m_tilde: m_tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp TILDE &kp SPACE>;
            label = "M_TILDE";
        };

        m_atilde: m_atilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp TILDE &kp A>;
            label = "m_atilde";
        };

        m_acaret: m_acaret {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp CARET &kp A>;
            label = "m_acaret";
        };

        m_ecaret: m_ecaret {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp CARET &kp E>;
            label = "m_ecaret";
        };

        m_otilde: m_otilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp TILDE &kp O>;
            label = "m_otilde";
        };

        m_ocaret: m_ocaret {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp CARET &kp O>;
            label = "m_ocaret";
        };

        m_crase: m_crase {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp A>;
            label = "M_CRASE";
        };

        m_crase_upper: m_crase_upper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp LS(A)>;
            label = "M_CRASE_UPPER";
        };

        m_caret: m_caret {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp CARET &kp SPACE>;
            label = "M_CARET";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            bindings = <
&lt 6 TAB            &kp Q            &kp W  &accent RA(E) E  &kp R                        &kp T                       &kp Y      &accent RA(U) U        &accent RA(I) I          &accent RA(O) O           &kp P          &kp MINUS
&mt LEFT_GUI ESCAPE  &accent RA(A) A  &kp S  &kp D            &homerow_shift LEFT_SHIFT F  &kp G                       &kp H      &homerow LEFT_SHIFT J  &homerow LCTRL K         &homerow LEFT_GUI L       &kp SEMICOLON  &m_quote
&tog 1               &kp Z            &kp X  &accent RA(C) C  &kp V                        &kp B                       &kp N      &lt 1 M                &accent RA(COMMA) COMMA  &homerow LEFT_ALT PERIOD  &kp FSLH       &kp CAPSLOCK
                                             &lt 4 TAB        &lt 2 SPACE                  &mt LEFT_SHIFT BACKSPACE    &lt 4 RET  &lt 3 SPACE            &lt 5 DELETE
            >;
        };

        NUM {
            bindings = <
&trans  &kp MINUS  &kp N1        &kp N2  &kp N3        &kp PLUS        &kp MINUS   &kp N1  &kp N2  &kp N3  &kp PLUS      &trans
&trans  &kp SLASH  &kp NUMBER_4  &kp N5  &kp NUMBER_6  &kp ASTERISK    &kp SLASH   &kp N4  &kp N5  &kp N6  &kp ASTERISK  &kp EQUAL
&trans  &kp DOT    &kp N7        &kp N8  &kp N9        &kp COMMA       &kp PERIOD  &kp N7  &kp N8  &kp N9  &kp COMMA     &kp ENTER
                                 &kp N0  &trans        &trans          &trans      &trans  &kp N0
            >;
        };

        SYM {
            bindings = <
&m_tilde  &m_quote         &kp LESS_THAN  &kp GREATER_THAN  &m_dquotes            &kp PERIOD    &kp AMPERSAND  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp COLON   &kp PERCENT   &trans
&m_grave  &kp EXCLAMATION  &kp MINUS      &kp PLUS          &kp EQUAL             &kp HASH      &kp PIPE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp COLON   &kp QUESTION  &trans
&m_caret  &m_caret         &kp PERCENT    &kp ASTERISK      &kp NON_US_BACKSLASH  &m_grave      &m_tilde       &kp LBRC              &kp RIGHT_BRACE        &kp DOLLAR  &kp AT_SIGN   &trans
                                          &trans            &trans                &trans        &trans         &trans                &trans
            >;
        };

        ACCENTS {
            bindings = <
&trans  &trans       &trans  &m_ecaret      &trans  &trans    &trans  &trans  &trans         &m_ocaret  &trans  &trans
&trans  &atilcarcra  &trans  &trans         &trans  &trans    &trans  &trans  &trans         &trans     &trans  &trans
&trans  &trans       &trans  &kp RA(COMMA)  &trans  &trans    &trans  &trans  &kp RA(COMMA)  &trans     &trans  &trans
                             &trans         &trans  &trans    &trans  &trans  &trans
            >;
        };

        NAV {
            bindings = <
&none  &none       &none       &kp C_VOLUME_UP    &kp F11        &kp LG(LS(L))    &trans  &trans          &trans          &trans        &trans           &trans
&none  &kp LA(F4)  &kp C_MUTE  &kp C_VOLUME_DOWN  &kp LG(LS(S))  &kp LC(F5)       &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans
&none  &none       &kp LC(X)   &kp LC(C)          &kp LC(V)      &none            &trans  &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END          &trans
                               &trans             &trans         &trans           &trans  &trans          &trans
            >;
        };

        FUN {
            bindings = <
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &kp PRINTSCREEN    &trans  &trans     &trans     &trans    &trans    &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &kp SCROLLLOCK     &trans  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &kp PAUSE_BREAK    &trans  &trans     &trans     &trans    &trans    &trans
                         &trans   &trans   &trans             &trans  &trans     &trans
            >;
        };

        BT {
            bindings = <
&trans  &trans        &bt BT_CLR_ALL  &trans        &bt BT_CLR    &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_SEL 3  &bt BT_SEL 2    &bt BT_SEL 1  &bt BT_SEL 0  &out OUT_TOG    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans          &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
                                      &trans        &trans        &trans          &trans  &trans  &trans
            >;
        };
    };
};
